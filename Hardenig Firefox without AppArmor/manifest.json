{
  "manifest_version": 2,
  "name": "Kiosk Guard",
  "version": "1.0.0",
  "description": "Handles URL capture, download size limit, and keyboard shortcut lockdown for isolated browser VM.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kiosk-guard@browser-vm",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
